---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, BLOG_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('rants')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<img
					src="/images/avatar-placeholder.svg"
					alt=""
					width="160"
					height="160"
					class="avatar"
				/>
				<div>
					<h1>{SITE_TITLE}</h1>
					<p>{SITE_DESCRIPTION}</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Latest from {BLOG_TITLE}</h2>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/rants/${post.id}/`}>
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	.intro {
		display: flex;
		align-items: center;
		gap: 1.5em;
		margin-bottom: 2em;
	}
	.avatar {
		border-radius: 50%;
		flex-shrink: 0;
	}
	@media (max-width: 500px) {
		.intro {
			flex-direction: column;
			align-items: flex-start;
		}
	}
	.section-title {
		font-size: 1.25em;
		margin-bottom: 1em;
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
		list-style-type: none;
		margin: 0;
		padding: 0;
	}
	ul li {
		width: 100%;
	}
	ul li a {
		display: block;
		text-decoration: none;
	}
	.title {
		margin: 0;
		color: rgb(var(--black));
		line-height: 1;
	}
	ul li a:hover h4 {
		color: var(--accent);
	}
	ul li .date {
		margin: 0;
		color: rgb(var(--gray));
	}
</style>
