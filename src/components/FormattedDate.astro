---
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString('en-us', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
			// Frontmatter dates parse as UTC midnight; a local zone behind UTC would show the previous day.
			timeZone: 'UTC',
		})
	}
</time>
